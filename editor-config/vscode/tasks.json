{
  "version": "2.0.0",
  "tasks": [
    { "label": "test", "type": "shell", "command": "${workspaceFolder}/.venv/bin/python -m pytest", "group": "test" },
    { "label": "lint", "type": "shell", "command": "${workspaceFolder}/.venv/bin/ruff check src tests" },
