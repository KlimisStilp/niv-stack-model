# Copy to .env (git-ignored) and fill in. Elexon and Open-Meteo need no key.
# ENTSO-E: request a token via https://transparency.entsoe.eu (My Account Settings -> Web API Security Token)
ENTSOE_API_KEY=
# Optional: where data is written (default ./data)
NIV_DATA_DIR=data
# Optional: Open-Meteo commercial key (free tier works without)
OPENMETEO_API_KEY=
